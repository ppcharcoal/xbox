#!/usr/bin/env python3
"""Xbox: the Xbox on the PC screen, from an HDMI capture card (UVC), with its sound.

Linux:   video with mpv straight from the card (/dev/videoN, V4L2); sound through a
         PipeWire loopback of the card's own audio input.
Windows: video with mpv from the card through DirectShow; sound from the card's
         DirectShow audio input in a second, window-less mpv. Cards and modes are
         listed with the bundled ffmpeg.exe.
The card and the best mode (1920x1080, highest frame rate) are found automatically.
"""

import argparse
import glob
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

APP = "xbox"
VERSION = "2.2.1"
WINDOWS = sys.platform == "win32"
BACKEND = "dshow" if WINDOWS else "v4l2"

if WINDOWS:
    RUNTIME_DIR = os.path.join(os.environ.get("LOCALAPPDATA") or tempfile.gettempdir(), "Xbox")
    CONFIG_PATH = os.path.join(os.environ.get("APPDATA") or os.path.expanduser("~"), "Xbox", "config.json")
else:
    RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    CONFIG_PATH = os.path.join(CONFIG_HOME, APP, "config.json")
PID_FILE = os.path.join(RUNTIME_DIR, f"{APP}.pid")
LOG_FILE = os.path.join(RUNTIME_DIR, f"{APP}.log")
SYSFS = "/sys"  # replaced in tests
MENU_STATE = os.path.join(RUNTIME_DIR, f"{APP}-menu.json")
# no console window for helper programs on Windows
NO_WINDOW = {"creationflags": 0x08000000} if WINDOWS else {}

DEFAULT_CONFIG = {
    # the capture card: /dev/videoN (Linux) or its name (Windows); empty = automatic
    "device": "",
    # wanted picture size; the highest frame rate available at this size is used
    "width": 1920,
    "height": 1080,
    # 0 = highest available
    "fps": 0,
    # "" = automatic (highest fps; at equal fps uncompressed YUYV before MJPG), or MJPG / YUYV / NV12
    "format": "",
    "fullscreen": True,
    # play the card's sound on the default output
    "audio": True,
    # PipeWire source (Linux) / DirectShow audio device (Windows); empty = the card's own
    "audio_source": "",
    # sound latency in ms (0 = default)
    "audio_latency_ms": 25,
    # no screen saver / lock while Xbox is open
    "inhibit_idle": True,
    # extra mpv options, e.g. ["--video-rotate=0"]
    "mpv_args": [],
}

# V4L2 fourcc -> FFmpeg v4l2 "input_format"
LAVF_FORMAT = {"MJPG": "mjpeg", "YUYV": "yuyv422", "NV12": "nv12", "YU12": "yuv420p", "RGB3": "rgb24"}
# V4L2 fourcc -> FFmpeg dshow option choosing that format
DSHOW_FORMAT = {"MJPG": "vcodec=mjpeg", "YUYV": "pixel_format=yuyv422", "NV12": "pixel_format=nv12",
                "YU12": "pixel_format=yuv420p", "RGB3": "pixel_format=bgr24"}
UNCOMPRESSED = {"YUYV", "NV12", "YU12", "RGB3"}


def log(msg):
    line = f"[{APP}] {msg}"
    if sys.stderr is not None:
        print(line, file=sys.stderr, flush=True)
        return
    try:  # Windows app without a console
        os.makedirs(RUNTIME_DIR, exist_ok=True)
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + line + "\n")
    except OSError:
        pass


def notify(text):
    log(text)
    if WINDOWS:
        try:
            import ctypes
            ctypes.windll.user32.MessageBoxW(None, text, "Xbox", 0x30 | 0x10000)  # warning, foreground
        except Exception:
            pass
    elif shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "Xbox", "-i", APP, "Xbox", text],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def app_dir():
    """Folder of Xbox.exe (Windows build) or of this script."""
    if getattr(sys, "frozen", False):
        return os.path.dirname(os.path.abspath(sys.executable))
    return os.path.dirname(os.path.realpath(__file__))


def tool(name):
    """Path of a helper program: on Windows the copy shipped next to Xbox.exe, else PATH."""
    if WINDOWS:
        for sub in ("", "mpv", "ffmpeg", os.path.join("ffmpeg", "bin")):
            path = os.path.join(app_dir(), sub, name + ".exe")
            if os.path.exists(path):
                return path
    return shutil.which(name)


def merge_config(user):
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    if not isinstance(user, dict):
        return cfg
    for key, value in user.items():
        if key not in cfg:
            continue
        default = cfg[key]
        if isinstance(default, bool):
            cfg[key] = bool(value)
        elif isinstance(default, int) and isinstance(value, (int, float)) and not isinstance(value, bool):
            cfg[key] = int(value)
        elif isinstance(default, str) and isinstance(value, str):
            cfg[key] = value
        elif isinstance(default, list) and isinstance(value, list):
            cfg[key] = [str(v) for v in value]
    return cfg


def load_config():
    try:
        with open(CONFIG_PATH, encoding="utf-8") as f:
            return merge_config(json.load(f))
    except FileNotFoundError:
        return merge_config(None)
    except (OSError, ValueError) as err:
        log(f"cannot read {CONFIG_PATH}: {err} (using defaults)")
        return merge_config(None)


# ----------------------------------------------------------------------------- modes

def parse_formats(text):
    """Modes from `v4l2-ctl --list-formats-ext`: [(fourcc, width, height, fps), ...]."""
    modes = []
    fourcc = None
    size = None
    for line in (text or "").splitlines():
        m = re.search(r"\[\d+\]:\s*'(\w{3,4})'", line)
        if m:
            fourcc, size = m.group(1).strip(), None
            continue
        m = re.search(r"Size:\s*\w+\s+(\d+)x(\d+)", line)
        if m:
            size = (int(m.group(1)), int(m.group(2)))
            continue
        m = re.search(r"Interval:.*\(([\d.]+)\s*fps\)", line)
        if m and fourcc and size:
            modes.append((fourcc, size[0], size[1], round(float(m.group(1)), 3)))
    return modes


def choose_mode(modes, width=1920, height=1080, fps=0, fmt=""):
    """Best mode: the wanted size (else the largest size that is not bigger), the highest
    frame rate (or the wanted one), and at equal frame rate uncompressed before MJPG."""
    usable = [m for m in modes if m[0] in LAVF_FORMAT]
    if fmt:
        usable = [m for m in usable if m[0] == fmt.upper()]
    if not usable:
        return None
    exact = [m for m in usable if (m[1], m[2]) == (width, height)]
    if not exact:
        smaller = [m for m in usable if m[1] <= width and m[2] <= height] or usable
        best_area = max(m[1] * m[2] for m in smaller)
        exact = [m for m in smaller if m[1] * m[2] == best_area]
    if fps:
        near = min(exact, key=lambda m: abs(m[3] - fps))
        exact = [m for m in exact if m[3] == near[3]]
    top = max(m[3] for m in exact)
    exact = [m for m in exact if m[3] == top]
    exact.sort(key=lambda m: (m[0] not in UNCOMPRESSED, m[0]))
    return exact[0]


def clean_fps(fps):
    fps = round(float(fps), 3)
    return float(round(fps)) if abs(fps - round(fps)) < 0.01 else fps


def parse_dshow_options(text):
    """Modes from `ffmpeg -f dshow -list_options true -i video=NAME`, as (fourcc, w, h, fps).
    Each line gives a size and a frame rate range; the highest rate is offered, and 60 and
    30 too when they are inside the range."""
    modes = []
    pattern = re.compile(r"(pixel_format|vcodec)=(\w+)\s+min s=(\d+)x(\d+) fps=([\d.]+)\s+"
                         r"max s=(\d+)x(\d+) fps=([\d.]+)")
    names = {v: k for k, v in DSHOW_FORMAT.items()}
    for line in (text or "").splitlines():
        m = pattern.search(line)
        if not m:
            continue
        fourcc = names.get(f"{m.group(1)}={m.group(2)}")
        if not fourcc:
            continue
        lo_w, lo_h, hi_w, hi_h = (int(m.group(i)) for i in (3, 4, 6, 7))
        lo_fps, hi_fps = clean_fps(m.group(5)), clean_fps(m.group(8))
        sizes = {(hi_w, hi_h)}
        for w, h in ((1920, 1080), (1280, 720)):  # a range of sizes
            if lo_w <= w <= hi_w and lo_h <= h <= hi_h:
                sizes.add((w, h))
        rates = {hi_fps} | {r for r in (60.0, 30.0) if lo_fps <= r < hi_fps}
        for w, h in sizes:
            for r in rates:
                if (fourcc, w, h, r) not in modes:
                    modes.append((fourcc, w, h, r))
    return modes


def parse_dshow_devices(text):
    """[{name, video, audio, alt}] from `ffmpeg -list_devices true -f dshow -i dummy`
    (both the newer "NAME" (video) lines and the older per-section listing)."""
    devices = []
    section = ""
    for line in (text or "").splitlines():
        if "DirectShow video devices" in line:
            section = "video"
            continue
        if "DirectShow audio devices" in line:
            section = "audio"
            continue
        alt = re.search(r'Alternative name "(.*)"', line)
        if alt:
            if devices:
                devices[-1]["alt"] = alt.group(1)
            continue
        m = re.search(r'\]\s+"(.+)"(?:\s+\(([^)]*)\))?\s*$', line)
        if m:
            kinds = m.group(2) if m.group(2) is not None else section
            devices.append({"name": m.group(1), "video": "video" in kinds,
                            "audio": "audio" in kinds, "alt": ""})
    return devices


def dshow_devices(ffmpeg=None):
    try:
        out = subprocess.run([ffmpeg or tool("ffmpeg") or "ffmpeg", "-hide_banner", "-list_devices", "true",
                              "-f", "dshow", "-i", "dummy"], capture_output=True, text=True,
                             encoding="utf-8", errors="replace", timeout=10, **NO_WINDOW)
    except (OSError, subprocess.SubprocessError):
        return []
    return parse_dshow_devices(out.stderr + out.stdout)


def dshow_modes(name, ffmpeg=None):
    try:
        out = subprocess.run([ffmpeg or tool("ffmpeg") or "ffmpeg", "-hide_banner", "-list_options", "true",
                              "-f", "dshow", "-i", f"video={name}"], capture_output=True, text=True,
                             encoding="utf-8", errors="replace", timeout=10, **NO_WINDOW)
    except (OSError, subprocess.SubprocessError):
        return []
    return parse_dshow_options(out.stderr + out.stdout)


def list_modes(dev):
    if WINDOWS:
        return dshow_modes(dev)
    try:
        out = subprocess.run(["v4l2-ctl", "--list-formats-ext", "-d", dev],
                             capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return []
    return parse_formats(out.stdout)


# ----------------------------------------------------------------------------- devices

CAPTURE_WORDS = re.compile(r"usb3|video|capture|hdmi|ms21|grabber|cam ?link|elgato|avermedia|ezcap", re.I)
WEBCAM_WORDS = re.compile(r"webcam|camera|integrated|face ?time|ir cam", re.I)


def usb_device_of(sysfs_device):
    """/sys/devices/.../usb2/2-5/2-5:1.0 -> /sys/devices/.../usb2/2-5 (the USB device itself)."""
    real = os.path.realpath(sysfs_device)
    return os.path.dirname(real) if re.search(r"/\d+-[\d.]+:\d+\.\d+$", real) else real


def video_devices(sysfs=None):
    """[{dev, name, usb}] for V4L2 nodes (capture and others; modes decide later).
    On Windows the DirectShow video devices, by name."""
    if WINDOWS and sysfs is None:
        return [{"dev": d["name"], "name": d["name"], "usb": None} for d in dshow_devices() if d["video"]]
    sysfs = sysfs or SYSFS
    out = []
    for node in sorted(glob.glob(os.path.join(sysfs, "class/video4linux/video*")),
                       key=lambda p: int(re.sub(r"\D", "", os.path.basename(p)) or 0)):
        try:
            with open(os.path.join(node, "name"), encoding="utf-8") as f:
                name = f.read().strip()
        except OSError:
            name = ""
        out.append({"dev": "/dev/" + os.path.basename(node), "name": name,
                    "usb": usb_device_of(os.path.join(node, "device"))})
    return out


def score_device(name, modes):
    """Higher = more likely the HDMI capture card."""
    score = 0
    if CAPTURE_WORDS.search(name):
        score += 10
    if WEBCAM_WORDS.search(name):
        score -= 20
    if any((m[1], m[2]) == (1920, 1080) and m[3] >= 50 for m in modes):
        score += 5
    return score


def find_capture(cfg, sysfs=None, modes_of=None, devices=None):
    """(device dict, modes) of the capture card, or (None, [])."""
    candidates = []
    for d in (devices if devices is not None else video_devices(sysfs)):
        if cfg["device"] and d["dev"] != cfg["device"]:
            continue
        modes = (modes_of or list_modes)(d["dev"])
        if not modes:  # metadata nodes have no formats
            continue
        candidates.append((score_device(d["name"], modes), d, modes))
    if not candidates:
        return None, []
    candidates.sort(key=lambda c: -c[0])
    _, d, modes = candidates[0]
    return d, modes


# ----------------------------------------------------------------------------- audio

def alsa_card_for(usb_dev, sysfs=None):
    """ALSA card number of the sound interface on the same USB device as the video."""
    for card in glob.glob(os.path.join(sysfs or SYSFS, "class/sound/card*")):
        m = re.search(r"card(\d+)$", card)
        if m and usb_device_of(os.path.join(card, "device")) == usb_dev:
            return int(m.group(1))
    return None


CARD_KEYS = ("api.alsa.pcm.card", "alsa.card", "api.alsa.card")


def pipewire_source_for_card(card, pw_dump):
    """node.name of the PipeWire audio source on ALSA card `card` (from `pw-dump` JSON).
    The card number is on the node (api.alsa.pcm.card / alsa.card) or only on its
    device object (api.alsa.card), depending on the PipeWire / WirePlumber version."""
    try:
        objects = json.loads(pw_dump) if isinstance(pw_dump, str) else pw_dump
    except ValueError:
        return None
    if not isinstance(objects, list):
        return None

    def props_of(obj):
        return ((obj.get("info") or {}).get("props") or {}) if isinstance(obj, dict) else {}

    devices = {obj.get("id"): props_of(obj) for obj in objects
               if isinstance(obj, dict) and str(obj.get("type", "")).endswith("Device")}
    for obj in objects:
        props = props_of(obj)
        if props.get("media.class") != "Audio/Source" or not props.get("node.name"):
            continue
        dev_props = devices.get(props.get("device.id"), {})
        for source in (props, dev_props):
            if any(str(source.get(k, "")) == str(card) for k in CARD_KEYS):
                return props["node.name"]
    return None


def find_audio_source(cfg, device, sysfs=None, pw_dump=None):
    if cfg["audio_source"]:
        return cfg["audio_source"]
    card = alsa_card_for(device["usb"], sysfs)
    if card is None:
        return None
    if pw_dump is None:
        try:
            pw_dump = subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.SubprocessError):
            return None
    return pipewire_source_for_card(card, pw_dump)


def dshow_audio_for(video_name, devices):
    """The DirectShow audio input of the capture card: the one named after the card
    (e.g. "Digital Audio Interface (USB3 Video)"), else one that looks like a capture card."""
    audio = [d["name"] for d in devices if d["audio"]]
    wanted = video_name.lower()
    for name in audio:
        if wanted and wanted in name.lower():
            return name
    for name in audio:
        if CAPTURE_WORDS.search(name) and not WEBCAM_WORDS.search(name) \
                and not re.search(r"microphone|mikrofon|realtek|headset|stereo mix", name, re.I):
            return name
    return None


def dshow_audio_cmd(name, cfg, mpv="mpv"):
    """Window-less mpv playing the card's sound with a small buffer."""
    buffer_ms = cfg["audio_latency_ms"] or 50
    return [mpv, f"av://dshow:audio={name}", "--no-config", "--profile=low-latency", "--no-video",
            "--force-window=no", "--cache=no", "--idle=no", "--terminal=no",
            f"--audio-buffer={buffer_ms / 1000:g}",
            f"--demuxer-lavf-o=audio_buffer_size={max(10, buffer_ms // 2)},fflags=+nobuffer",
            "--title=Xbox (dźwięk)"]


def loopback_cmd(source, cfg):
    cmd = ["pw-loopback", "-n", "xbox-audio", "-C", source,
           "--playback-props", "media.role=Game node.description=Xbox"]
    if cfg["audio_latency_ms"] > 0:
        cmd += ["-l", str(cfg["audio_latency_ms"])]
    return cmd


# ----------------------------------------------------------------------------- idle

def inhibit_cmd():
    """Keeps the screen saver / lock away for as long as the process lives. mpv's own
    Wayland idle inhibitor only counts while its window is visible, so this covers the
    rest (another workspace, the menu, a window behind others)."""
    return ["systemd-inhibit", "--what=idle", "--who=Xbox", "--why=Obraz z konsoli Xbox",
            "--mode=block", "sleep", "infinity"]


class KeepAwake:
    """Windows: no screen saver, lock or sleep while Xbox is open."""
    FLAGS = 0x80000000 | 0x00000002 | 0x00000001  # ES_CONTINUOUS | DISPLAY | SYSTEM_REQUIRED

    def __enter__(self):
        self._set(self.FLAGS)
        return self

    def __exit__(self, *_):
        self._set(0x80000000)

    @staticmethod
    def _set(flags):
        try:
            import ctypes
            ctypes.windll.kernel32.SetThreadExecutionState(ctypes.c_uint(flags))
        except Exception:
            pass


_JOB = None


def children_die_with_me():
    """Windows: put this process in a job that closes mpv (picture and sound) when Xbox
    ends in any way, also when it is killed by `--toggle`."""
    global _JOB
    try:
        import ctypes
        from ctypes import wintypes

        class Basic(ctypes.Structure):
            _fields_ = [("PerProcessUserTimeLimit", ctypes.c_int64), ("PerJobUserTimeLimit", ctypes.c_int64),
                        ("LimitFlags", wintypes.DWORD), ("MinimumWorkingSetSize", ctypes.c_size_t),
                        ("MaximumWorkingSetSize", ctypes.c_size_t), ("ActiveProcessLimit", wintypes.DWORD),
                        ("Affinity", ctypes.c_size_t), ("PriorityClass", wintypes.DWORD),
                        ("SchedulingClass", wintypes.DWORD)]

        class Extended(ctypes.Structure):
            _fields_ = [("BasicLimitInformation", Basic), ("IoInfo", ctypes.c_uint64 * 6),
                        ("ProcessMemoryLimit", ctypes.c_size_t), ("JobMemoryLimit", ctypes.c_size_t),
                        ("PeakProcessMemoryUsed", ctypes.c_size_t), ("PeakJobMemoryUsed", ctypes.c_size_t)]

        k32 = ctypes.WinDLL("kernel32", use_last_error=True)
        # exact C types: GetCurrentProcess() is the pseudo-handle -1, which does not fit
        # ctypes' default int argument on 64-bit Windows
        k32.CreateJobObjectW.restype = wintypes.HANDLE
        k32.CreateJobObjectW.argtypes = [ctypes.c_void_p, wintypes.LPCWSTR]
        k32.SetInformationJobObject.restype = wintypes.BOOL
        k32.SetInformationJobObject.argtypes = [wintypes.HANDLE, ctypes.c_int, ctypes.c_void_p, wintypes.DWORD]
        k32.GetCurrentProcess.restype = wintypes.HANDLE
        k32.GetCurrentProcess.argtypes = []
        k32.AssignProcessToJobObject.restype = wintypes.BOOL
        k32.AssignProcessToJobObject.argtypes = [wintypes.HANDLE, wintypes.HANDLE]
        job = k32.CreateJobObjectW(None, None)
        info = Extended()
        info.BasicLimitInformation.LimitFlags = 0x2000  # JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
        if job and k32.SetInformationJobObject(job, 9, ctypes.byref(info), ctypes.sizeof(info)) \
                and k32.AssignProcessToJobObject(job, k32.GetCurrentProcess()):
            _JOB = job  # the handle stays open for as long as Xbox runs
        else:
            log(f"job object unavailable (error {ctypes.get_last_error()})")
    except Exception as err:  # never stop Xbox over this extra
        log(f"job object unavailable: {err!r}")


def lua_path(path):
    """A path mpv's Lua can open on Windows: Lua's io.open does not take UTF-8 names, so a
    user folder like C:\\Users\\Paweł gets its short (8.3) ASCII form."""
    if not WINDOWS or path.isascii():
        return path
    try:
        import ctypes
        buf = ctypes.create_unicode_buffer(1024)
        if ctypes.windll.kernel32.GetShortPathNameW(path, buf, 1024) and buf.value.isascii():
            return buf.value
    except Exception:
        pass
    return path


# ----------------------------------------------------------------------------- video

_MPV_OPTIONS = None


def mpv_options(mpv="mpv"):
    """Option names this mpv knows (they change between mpv versions)."""
    global _MPV_OPTIONS
    if _MPV_OPTIONS is None:
        try:
            out = subprocess.run([mpv, "--list-options"], capture_output=True, text=True, encoding="utf-8",
                                 errors="replace", timeout=10, **NO_WINDOW).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        _MPV_OPTIONS = set(re.findall(r"^\s*--([\w-]+)", out, re.M))
    return _MPV_OPTIONS


def no_wait_options(known):
    """Do not let mpv wait for the compositor's frame callbacks / a blocking swapchain:
    on Wayland a hidden window (another workspace) gets none, and mpv in low-latency mode
    would hang there ("Application not responding" after switching back)."""
    opts = ["--vulkan-swap-mode=mailbox"] if "vulkan-swap-mode" in known else []
    if "swapchain-depth" in known:  # one frame in flight instead of up to three
        opts.append("--swapchain-depth=1")
    if "wayland-internal-vsync" in known:       # mpv >= 0.38
        opts.append("--wayland-internal-vsync=no")
    elif "wayland-disable-vsync" in known:      # older mpv
        opts.append("--wayland-disable-vsync=yes")
    return opts


def menu_script():
    """menu.lua next to Xbox.exe / this file (repo) or the installed copy."""
    for folder in (app_dir(), os.path.dirname(os.path.realpath(__file__))):
        here = os.path.join(folder, "menu.lua")
        if os.path.exists(here):
            return here
    return "/usr/share/xbox/menu.lua"


def card_url(dev, backend=None):
    return f"av://dshow:video={dev}" if (backend or BACKEND) == "dshow" else f"av://v4l2:{dev}"


def lavf_options(mode, backend=None):
    """FFmpeg input options that open the card in this mode (--demuxer-lavf-o)."""
    fourcc, width, height, fps = mode
    if (backend or BACKEND) == "dshow":
        fmt = DSHOW_FORMAT[fourcc]
    else:
        fmt = f"input_format={LAVF_FORMAT[fourcc]}"
    return f"video_size={width}x{height},framerate={fps:g},{fmt},fflags=+nobuffer"


def menu_entry(m, backend=None):
    return [m[0], m[1], m[2], m[3], lavf_options(m, backend)]


def menu_modes(modes, backend=None):
    """Modes for the settings menu: usable ones, uncompressed first, big and fast first.
    Each is [fourcc, width, height, fps, FFmpeg options opening it]."""
    usable = sorted({m for m in modes if m[0] in LAVF_FORMAT},
                    key=lambda m: (m[0] not in UNCOMPRESSED, m[0], -m[1] * m[2], -m[3]))
    return [menu_entry(m, backend) for m in usable]


def write_menu_state(dev, modes, mode, cfg, path=None, backend=None):
    """What the settings menu needs: the card URL, its modes, the current and the best one."""
    best = choose_mode(modes, 1920, 1080, 0, "")
    state = {
        "url": card_url(dev, backend),
        "modes": menu_modes(modes, backend),
        "current": menu_entry(mode, backend),
        "best": menu_entry(best, backend) if best else None,
        "auto": not cfg["format"] and not cfg["fps"],
        "config_path": lua_path(CONFIG_PATH),
    }
    path = path or MENU_STATE
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(state, f)
    return path


def ensure_config():
    """The settings menu saves into the config file, so it has to exist."""
    if not os.path.exists(CONFIG_PATH):
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(DEFAULT_CONFIG, f, indent=2)
            f.write("\n")


def mpv_cmd(dev, mode, cfg, known=None, menu_state=None, backend=None, mpv="mpv"):
    backend = backend or BACKEND
    cmd = [
        mpv, card_url(dev, backend),
        "--no-config",                 # predictable: no user scripts or settings in the way
        "--profile=low-latency",
        "--untimed", "--cache=no",
        f"--demuxer-lavf-o={lavf_options(mode, backend)}",
        "--demuxer-lavf-analyzeduration=0.1",
        "--no-audio",                  # sound is played separately (lower latency)
        "--hwdec=no",
        "--interpolation=no",
        "--title=Xbox",
    ] + ([] if backend == "dshow" else [f"--wayland-app-id={APP}"]) + [
        "--osc=no", "--osd-level=1", "--cursor-autohide=1000",
        "--keep-open=no", "--idle=no",
        "--stop-screensaver=yes",
        "--msg-level=all=warn",
    ] + no_wait_options(mpv_options(mpv) if known is None else known)
    if cfg["fullscreen"]:
        cmd.append("--fs")
    if menu_state:
        cmd += [f"--script={menu_script()}", f"--script-opts=xbox-state={lua_path(menu_state)}"]
    return cmd + list(cfg["mpv_args"])


# ----------------------------------------------------------------------------- single instance

def windows_image_of(pid):
    """Program path of a running process on Windows, or None."""
    try:
        import ctypes
        from ctypes import wintypes
        k32 = ctypes.WinDLL("kernel32")
        k32.OpenProcess.restype = wintypes.HANDLE
        k32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
        handle = k32.OpenProcess(0x1000, False, pid)  # PROCESS_QUERY_LIMITED_INFORMATION
        if not handle:
            return None
        try:
            buf = ctypes.create_unicode_buffer(1024)
            size = wintypes.DWORD(1024)
            if not k32.QueryFullProcessImageNameW(wintypes.HANDLE(handle), 0, buf, ctypes.byref(size)):
                return None
            code = wintypes.DWORD()
            if k32.GetExitCodeProcess(wintypes.HANDLE(handle), ctypes.byref(code)) and code.value != 259:
                return None  # exited (259 = STILL_ACTIVE)
            return buf.value
        finally:
            k32.CloseHandle(wintypes.HANDLE(handle))
    except Exception:
        return None


def running_pid():
    try:
        with open(PID_FILE, encoding="utf-8") as f:
            pid = int(f.read().strip())
    except (OSError, ValueError):
        return None
    if WINDOWS:
        image = os.path.basename(windows_image_of(pid) or "").lower()
        return pid if ("xbox" in image or "python" in image) else None
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if APP.encode() not in f.read():
                return None
    except OSError:
        return None
    return pid


def write_pid():
    os.makedirs(RUNTIME_DIR, exist_ok=True)
    with open(PID_FILE, "w", encoding="utf-8") as f:
        f.write(str(os.getpid()))


def remove_pid():
    try:
        if running_pid() == os.getpid():
            os.remove(PID_FILE)
    except OSError:
        pass


# ----------------------------------------------------------------------------- run

def stop(proc, timeout=3):
    if proc and proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            proc.kill()


def missing_tools(cfg):
    if WINDOWS:
        return [t for t in ("mpv", "ffmpeg") if not tool(t)]
    need = ["mpv", "v4l2-ctl"] + (["pw-loopback", "pw-dump"] if cfg["audio"] else [])
    return [t for t in need if not shutil.which(t)]


def failed_to_open(err):
    detail = (err or "").strip().splitlines()[-1:] or [""]
    if re.search(r"busy|already in use|could not run graph", " ".join((err or "").splitlines()[-5:]), re.I):
        notify("Karta jest zajęta przez inny program (np. OBS). Zamknij go i spróbuj ponownie.")
    else:
        notify(f"Nie udało się otworzyć obrazu z karty. {detail[0]}")


def run_windows(cfg):
    missing = missing_tools(cfg)
    if missing:
        notify("Brakuje plików " + ", ".join(t + ".exe" for t in missing) +
               ". Rozpakuj całe archiwum Xbox (z folderami mpv i ffmpeg) i uruchom Xbox.exe z niego.")
        return 1
    mpv = tool("mpv")
    children_die_with_me()
    all_devices = dshow_devices(tool("ffmpeg"))
    videos = [{"dev": d["name"], "name": d["name"], "usb": None} for d in all_devices if d["video"]]
    device, modes = find_capture(cfg, devices=videos)
    if not device:
        notify("Nie widzę karty przechwytującej. Podłącz ją do portu USB 3 (nie przez hub).")
        return 1
    mode = choose_mode(modes, cfg["width"], cfg["height"], cfg["fps"], cfg["format"])
    if not mode:
        notify(f"Karta {device['name']} nie ma obsługiwanego trybu obrazu.")
        return 1
    log(f"{device['name']}: {mode[0]} {mode[1]}x{mode[2]} @ {mode[3]:g} fps")

    audio = None
    if cfg["audio"]:
        source = cfg["audio_source"] or dshow_audio_for(device["name"], all_devices)
        if source:
            log(f"sound: {source}")
            audio = subprocess.Popen(dshow_audio_cmd(source, cfg, mpv), stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, **NO_WINDOW)
        else:
            log("the card's sound input was not found: sound is off")

    try:
        ensure_config()
        menu_state = write_menu_state(device["dev"], modes, mode, cfg)
    except OSError as err:
        log(f"settings menu unavailable: {err}")
        menu_state = None

    started = time.monotonic()
    with KeepAwake():
        video = subprocess.Popen(mpv_cmd(device["dev"], mode, cfg, menu_state=menu_state, mpv=mpv),
                                 stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
                                 encoding="utf-8", errors="replace", **NO_WINDOW)
        try:
            _, err = video.communicate()
        except KeyboardInterrupt:
            stop(video)
            err = ""
    stop(audio)
    if menu_state:
        try:
            os.remove(menu_state)
        except OSError:
            pass
    if video.returncode not in (0, None, 4) and time.monotonic() - started < 5:
        failed_to_open(err)
        return 1
    return 0


def run(cfg):
    if WINDOWS:
        return run_windows(cfg)
    missing = missing_tools(cfg)
    if "mpv" in missing or "v4l2-ctl" in missing:
        notify(f"Brakuje programów: {', '.join(missing)}. Zainstaluj: sudo pacman -S mpv v4l-utils")
        return 1

    device, modes = find_capture(cfg)
    if not device:
        notify("Nie widzę karty przechwytującej. Podłącz ją do portu USB 3 (nie przez hub).")
        return 1
    mode = choose_mode(modes, cfg["width"], cfg["height"], cfg["fps"], cfg["format"])
    if not mode:
        notify(f"Karta {device['name']} nie ma obsługiwanego trybu obrazu.")
        return 1
    log(f"{device['name']} ({device['dev']}): {mode[0]} {mode[1]}x{mode[2]} @ {mode[3]:g} fps")

    audio = None
    if cfg["audio"]:
        if "pw-loopback" in missing or "pw-dump" in missing:
            log("no PipeWire tools: sound is off")
        else:
            source = find_audio_source(cfg, device)
            if source:
                log(f"sound: {source}")
                audio = subprocess.Popen(loopback_cmd(source, cfg), stdout=subprocess.DEVNULL,
                                         stderr=subprocess.DEVNULL, start_new_session=True)
            else:
                log("the card's sound input was not found: sound is off")

    inhibitor = None
    if cfg["inhibit_idle"] and shutil.which("systemd-inhibit"):
        inhibitor = subprocess.Popen(inhibit_cmd(), stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, start_new_session=True)

    try:
        ensure_config()
        menu_state = write_menu_state(device["dev"], modes, mode, cfg)
    except OSError as err:
        log(f"settings menu unavailable: {err}")
        menu_state = None

    started = time.monotonic()
    video = subprocess.Popen(mpv_cmd(device["dev"], mode, cfg, menu_state=menu_state),
                             stderr=subprocess.PIPE, text=True)

    def on_signal(*_):
        stop(video)

    for sig in (signal.SIGTERM, signal.SIGINT, getattr(signal, "SIGHUP", None)):
        if sig is not None:
            signal.signal(sig, on_signal)

    _, err = video.communicate()
    stop(audio)
    stop(inhibitor)
    if menu_state:
        try:
            os.remove(menu_state)
        except OSError:
            pass
    code = video.returncode
    if code not in (0, None, -signal.SIGTERM, 4) and time.monotonic() - started < 5:
        failed_to_open(err)
        return 1
    return 0


def cmd_list_windows(cfg):
    ffmpeg = tool("ffmpeg")
    if not ffmpeg:
        print("ffmpeg.exe not found next to Xbox.exe.")
        return 1
    all_devices = dshow_devices(ffmpeg)
    videos = [{"dev": d["name"], "name": d["name"], "usb": None} for d in all_devices if d["video"]]
    if not videos:
        print("No video devices.")
        return 1
    chosen, _ = find_capture(cfg, devices=videos)
    for d in videos:
        modes = dshow_modes(d["name"], ffmpeg)
        mark = "  <- Xbox" if chosen and chosen["dev"] == d["dev"] else ""
        print(f'"{d["name"]}"{mark}')
        best = choose_mode(modes, cfg["width"], cfg["height"], cfg["fps"], cfg["format"])
        for m in sorted(set(modes), key=lambda m: (-m[1] * m[2], -m[3], m[0])):
            if (m[1], m[2]) in ((1920, 1080), (1280, 720), (2560, 1440), (3840, 2160)):
                print(f"    {m[0]} {m[1]}x{m[2]} @ {m[3]:g} fps{'   (used)' if m == best else ''}")
    print("audio inputs: " + (", ".join(f'"{d["name"]}"' for d in all_devices if d["audio"]) or "none"))
    if chosen:
        print(f"sound: {cfg['audio_source'] or dshow_audio_for(chosen['name'], all_devices) or 'not found'}")
    return 0


def cmd_list(cfg):
    if WINDOWS:
        return cmd_list_windows(cfg)
    devices = video_devices()
    if not devices:
        print("No video devices.")
        return 1
    chosen, _ = find_capture(cfg)
    for d in devices:
        modes = list_modes(d["dev"])
        if not modes:
            continue
        mark = "  <- Xbox" if chosen and chosen["dev"] == d["dev"] else ""
        print(f"{d['dev']}: {d['name']}{mark}")
        best = choose_mode(modes, cfg["width"], cfg["height"], cfg["fps"], cfg["format"])
        for m in sorted(set(modes), key=lambda m: (-m[1] * m[2], -m[3], m[0])):
            if (m[1], m[2]) in ((1920, 1080), (1280, 720), (2560, 1440), (3840, 2160)):
                print(f"    {m[0]} {m[1]}x{m[2]} @ {m[3]:g} fps{'   (used)' if m == best else ''}")
    if chosen:
        card = alsa_card_for(chosen["usb"])
        source = find_audio_source(cfg, chosen) if shutil.which("pw-dump") else None
        print(f"sound card (ALSA): {card if card is not None else 'not found on this USB device'}")
        print(f"sound: {source or 'not found'}")
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog=APP, description="The Xbox from an HDMI capture card, on the PC screen.")
    parser.add_argument("--toggle", action="store_true", help="close Xbox if it is open, otherwise open it")
    parser.add_argument("--fullscreen", action="store_true", help="start in fullscreen")
    parser.add_argument("--windowed", action="store_true", help="start in a window")
    parser.add_argument("--device", help="capture device, e.g. /dev/video0 (Windows: its name)")
    parser.add_argument("--format", help="picture format: MJPG or YUYV (default: automatic)")
    parser.add_argument("--no-audio", action="store_true", help="no sound")
    parser.add_argument("--list", action="store_true", help="show capture devices and modes")
    parser.add_argument("--config", action="store_true", help="create the config file and print its path")
    parser.add_argument("--version", action="version", version=VERSION)
    args = parser.parse_args(argv)

    cfg = load_config()
    if args.fullscreen:
        cfg["fullscreen"] = True
    if args.windowed:
        cfg["fullscreen"] = False
    if args.device:
        cfg["device"] = args.device
    if args.format:
        cfg["format"] = args.format.upper()
    if args.no_audio:
        cfg["audio"] = False

    if args.config:
        if not os.path.exists(CONFIG_PATH):
            os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
            with open(CONFIG_PATH, "w", encoding="utf-8") as f:
                json.dump(DEFAULT_CONFIG, f, indent=2)
                f.write("\n")
        print(CONFIG_PATH)
        return 0
    if args.list:
        return cmd_list(cfg)

    pid = running_pid()
    if pid:
        if args.toggle:
            os.kill(pid, signal.SIGTERM)
        else:
            log("already open")
        return 0

    write_pid()
    try:
        return run(cfg)
    finally:
        remove_pid()


if __name__ == "__main__":
    sys.exit(main())

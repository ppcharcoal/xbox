[Desktop Entry]
Type=Application
Name=Xbox Play
GenericName=Xbox Remote Play
Comment=Xbox Remote Play z Better xCloud
Exec=xbox-play %U
Icon=xbox-play
Terminal=false
Categories=Game;
Keywords=xbox;remote;play;console;konsola;
StartupWMClass=xbox-play
Actions=pick;fullscreen;

[Desktop Action pick]
Name=Wybierz konsolę
Exec=xbox-play --pick

[Desktop Action fullscreen]
Name=Pełny ekran
Exec=xbox-play --fullscreen
